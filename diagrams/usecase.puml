' alt + d
@startuml usecase-diagram
skinparam shadowing false
skinparam backgroundColor #f9f9f9
skinparam usecase {
    BackgroundColor #e6f7ff
    BorderColor #1890ff
    FontColor #000000
    FontSize 14
    Shadowing true
}
skinparam actor {
    BackgroundColor #fff2e8
    BorderColor #fa8c16
    FontColor #000000
    FontSize 14
}
skinparam rectangle {
    BackgroundColor #fffbe6
    BorderColor #d48806
    FontColor #000000
    FontSize 18
    Shadowing true
}
skinparam note{
    BackgroundColor #faf2b9
    BorderColor #c51c1c
}
left to right direction

actor "Quản trị viên" as Admin
actor "Người thuê" as Guest
actor "Chủ căn hộ" as Owner

rectangle "Ứng dụng quản lý & tìm kiếm căn hộ"{
' Các chức năng của Chủ căn hộ
' usecase "Đăng xuất" as logout
usecase "Đăng nhập" as login
usecase "Đăng ký" as register
usecase "Quản lý tài khoản" as manage_account
note bottom of manage_account: Xem, Thay đổi thông tin, Đổi mật khẩu, Đăng xuất
usecase "Yêu cầu xác minh tài khoản" as request_owner_verification

usecase "Nạp tiền" as deposit
usecase "Rút tiền" as withdraw
usecase "Xóa tài khoản" as delete_account
usecase "Quản lý căn hộ" as manage_apartment
note bottom of manage_apartment: Thêm, Sửa, Xóa căn hộ, Tìm kiếm, Xem
' usecase "Kết nối khóa cửa IoT" as connect_iot_lock
' manage_apartment .. connect_iot_lock: extend

usecase "Quản lý yêu cầu đặt phòng" as manage_booking
note top of manage_booking: Cập nhật yêu cầu đặt phòng
usecase "Xem hợp đồng" as view_booking_contract
manage_booking .. view_booking_contract: extend
usecase "Quản lý hóa đơn" as manage_invoice
' note bottom of manage_invoice: Hoàn tiền
usecase "Quản lý bài đăng" as manage_post
note bottom of manage_post: Tạo, Chỉnh sửa, Ẩn
usecase "Xóa bài đăng" as delete_post
usecase "Nhắn tin" as messaging
usecase "Thống kê" as statistics

' usecase "Xác thực dữ liệu đặt phòng" as verify_booking_data
' view_booking_contract .. verify_booking_data: extend

' Các chức năng của Người thuê
' usecase "Quản lý tài khoản" as manage_account
' usecase "Đăng xuất" as logout
' usecase "Đăng nhập" as login
' usecase "Đăng ký" as register
' usecase "Tìm kiếm căn hộ" as search_apartment
' usecase "Xem chi tiết căn hộ" as view_apartment_details
' manage_apartment .. search_apartment: extend
' search_apartment . view_apartment_details: extend

usecase "Đặt phòng" as book_apartment
' usecase "Hủy đặt phòng" as cancel_booking

usecase "Tìm kiếm yêu cầu đặt phòng" as search_booking
manage_booking .. search_booking: extend
usecase "Xem yêu cầu đặt phòng" as view_booking_requests
search_booking . view_booking_requests: extend


usecase "Tìm kiếm hóa đơn" as search_invoices
manage_invoice .. search_invoices: extend
usecase "Xem chi tiết hóa đơn" as view_invoice_details
search_invoices . view_invoice_details: extend
usecase "Tìm kiếm bài đăng" as search_posts
manage_post .. search_posts: extend
usecase "Xem chi tiết bài đăng" as view_post_details
search_posts . view_post_details: extend
' usecase "Nhắn tin" as messaging

' usecase "Báo cáo vi phạm" as report_violation

' Các chức năng của Quản trị viên
usecase "Quản lý tài khoản người dùng" as manage_user_accounts
note top of manage_user_accounts: Xem, Khóa, Mở khóa, Xóa tài khoản, Duyệt xác minh chủ căn hộ
' usecase "Đăng xuất" as logout
' usecase "Đăng nhập" as login
' usecase "Đổi mật khẩu" as change_password
' manage_account .. change_password: extend
'usecase "Quản lý bài đăng" as manage_post
usecase "Duyệt bài đăng" as approve_posts
' usecase "Thống kê" as statistics
usecase "Xem thống kê" as view_statistics
usecase "Quản lý thiết bị IoT" as manage_iot_devices
note bottom of manage_iot_devices: Thêm, Sửa, Xóa, Xem và kiểm tra thiết bị IoT
usecase "Quản lý giao dịch" as manage_transactions
note bottom of manage_transactions: Xem lịch sử giao dịch, duyệt yêu cầu rút tiền, từ chối yêu cầu rút tiền
' nối các usecase
'Chủ căn hộ
(Owner) -- (login)
(Owner) -- (register)
(Owner) -- (manage_account)
(request_owner_verification) - (Owner)
(Owner) -- (manage_apartment)
(Owner) -- (manage_booking)
(Owner) -- (manage_invoice)
(Owner) -- (manage_post)
(Owner) -- (messaging)
(Owner) -- (statistics)
(Owner) -- (manage_iot_devices)
' (Owner) -- (connect_iot_lock)
(Owner) -- (withdraw)
(Owner) -- (delete_account)


'Người thuê
(register) - (Guest)
(login) - (Guest)
(manage_account) -- (Guest)
(search_posts) -- (Guest)
(book_apartment) - (Guest)
' (cancel_booking) - (Guest)
(search_booking) -- (Guest)
(search_invoices) -- (Guest)
(view_booking_contract) -- (Guest)
(messaging) - (Guest)
' (report_violation) - (Guest)
(deposit) - (Guest)
(withdraw) - (Guest)
(delete_account) - (Guest)

'Quản trị viên
(login) --- (Admin)
(manage_user_accounts) - (Admin)
(manage_account) -- (Admin)
(search_posts) -- (Admin)
(approve_posts) - (Admin)
(delete_post) -- (Admin)
' (change_password) -- (Admin)
(statistics) - (Admin)
(view_statistics) -- (Admin)
(manage_iot_devices) - (Admin)
(search_booking) -- (Admin)
(view_booking_contract) -- (Admin)
(manage_transactions) - (Admin)
}
@enduml

