' alt + d
@startuml usecase_guest-diagram
' skinparam shadowing false
' skinparam backgroundColor #f9f9f9
' skinparam usecase {
'     BackgroundColor #e6f7ff
'     BorderColor #1890ff
'     FontColor #000000
'     FontSize 14
'     Shadowing true
' }
' skinparam actor {
'     BackgroundColor #fff2e8
'     BorderColor #fa8c16
'     FontColor #000000
'     FontSize 14
' }
' skinparam rectangle {
'     BackgroundColor #fffbe6
'     BorderColor #d48806
'     FontColor #000000
'     FontSize 18
'     Shadowing true
' }
' skinparam note{
'     BackgroundColor #faf2b9
'     BorderColor #c51c1c
' }
left to right direction

actor "Người thuê" as Guest

rectangle "  "{
usecase "Đăng ký" as register
usecase "Đăng nhập" as login
usecase "Quản lý tài khoản" as manage_account
note bottom of manage_account: Xem, Thay đổi thông tin, Đổi mật khẩu, Đăng xuất, Xóa tài khoản

usecase "Nạp tiền" as deposit
usecase "Rút tiền" as withdraw

usecase "Tìm kiếm bài đăng" as search_posts
usecase "Xem chi tiết bài đăng" as view_post_details
search_posts . view_post_details: extend

usecase "Đặt phòng" as book_apartment

usecase "Tìm kiếm yêu cầu đặt phòng" as search_booking
usecase "Xem yêu cầu đặt phòng" as view_booking_requests
search_booking . view_booking_requests: extend

usecase "Tìm kiếm hóa đơn" as search_invoices
usecase "Xem hóa đơn" as view_invoice_details
search_invoices . view_invoice_details: extend

usecase "Xem hợp đồng" as view_booking_contract

usecase "Nhắn tin" as messaging



(register) -- (Guest)
(login) -- (Guest)
(manage_account) -- (Guest)
(search_posts) -- (Guest)
(book_apartment) -- (Guest)
(search_booking) -- (Guest)
(search_invoices) -- (Guest)
(view_booking_contract) -- (Guest)
(messaging) -- (Guest)
(deposit) -- (Guest)
(withdraw) -- (Guest)
}
@enduml
